<div class="container">
  <h1 class="my-3"><%= @restaurant.name %></h1>

  <p><strong>Location: </strong><%= @restaurant.address %></p>
  <p><strong>Phone number: </strong><%= @restaurant.phone_number %></p>
  <p><strong>Type: </strong><%= @restaurant.category %></p>

  <p><strong>Reviews:</strong></h3>
  <ul class="list-group">
  <% @restaurant.reviews.each do |review| %>
    <li class="list-group-item">
      <%= review.content %> - <%= review.rating %>/5
    </li>
  <% end %>
  </ul>

  <p class="mt-5"><strong>Add a review:</strong></p>

  <%= render "reviews/form_review", restaurant: @restaurant, review: @review %>

  <%= link_to "Back to Restaurants", restaurants_path, class: "btn btn-primary mt-3" %>
</div>
